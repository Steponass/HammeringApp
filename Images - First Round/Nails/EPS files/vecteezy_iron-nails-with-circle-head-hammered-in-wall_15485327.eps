   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Iron nails with circle head hammered in wall</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Iron nails hammered in wall, straight and bent steel spikes with circle head. Vector realistic set of metal pins, hardware hobnails, carpentry and construction tools isolated on transparent background</rdf:li>
    </rdf:Alt>
   </dc:description>
